// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Seller {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum BlingOrderSyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
}

enum BlingWebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

model BlingOrderSync {
  id              String             @id @default(cuid())
  shopDomain      String
  shopifyOrderId  String
  shopifyOrderName String
  sellerId        String?
  sellerName      String?
  blingContactId  String?
  blingContactName String?
  blingOrderId    String?
  webhookId       String?
  status          BlingOrderSyncStatus @default(PENDING)
  attempts        Int                @default(0)
  lastError       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  webhookEvents   BlingWebhookEvent[]

  @@unique([shopDomain, shopifyOrderId])
  @@index([status, updatedAt])
}

model BlingWebhookEvent {
  eventId             String                  @id
  event               String
  version             String
  companyId           String
  blingOrderId        String
  shopifyOrderId      String
  payload             Json
  status              BlingWebhookEventStatus @default(PENDING)
  attempts            Int                     @default(0)
  lastError           String?
  processingStartedAt DateTime?
  processedAt         DateTime?
  syncId              String?
  sync                BlingOrderSync?         @relation(fields: [syncId], references: [id], onDelete: SetNull)
  receivedAt          DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([shopifyOrderId])
  @@index([syncId])
}

model BlingOAuthToken {
  id           String   @id
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlingOAuthState {
  state     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}
